# Copy to .env and fill in. Never commit .env.
HOSTOP_DB_URL=sqlite:///hostop.db
HOSTOP_CONFIG=config/hostop.yaml
HOSTOP_USER_AGENT=HostOpPipelineBot/0.1 (+contact via company website)

# Drafting (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Web discovery
FIRECRAWL_API_KEY=

# Enrichment (free tiers)
APOLLO_API_KEY=
HUNTER_API_KEY=

# CRM
ATTIO_API_KEY=

# n8n hook auth (shared secret sent as X-HostOp-Token)
HOSTOP_API_TOKEN=change-me
